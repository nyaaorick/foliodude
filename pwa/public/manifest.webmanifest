{
  "name": "FolioDude",
  "short_name": "FolioDude",
  "description": "Local-first personal finance tracker. Your data never leaves your device.",
  "id": "/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FAF5ED",
  "theme_color": "#FAF5ED",
  "icons": [
    { "src": "./icon/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "maskable" }
  ]
}
