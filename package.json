{
  "name": "foliodude",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nyaaorick/foliodude.git"
  },
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:firefox": "wxt -b firefox",
    "dev:pwa": "vite --config vite.pwa.config.ts",
    "build:firefox": "wxt build -b firefox",
    "build:pwa": "vite build --config vite.pwa.config.ts",
    "build": "npm run build:firefox && npm run build:pwa",
    "zip:firefox": "wxt zip -b firefox",
    "preview:pwa": "vite preview --config vite.pwa.config.ts",
    "postinstall": "wxt prepare",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "harness:ai": "node features/ai/eval/run.mjs",
    "ai:test": "vitest run features/ai/tests",
    "ai:ui": "node features/ai/eval/ui.mjs",
    "ai:verify": "node features/ai/eval/verify.mjs",
    "ai:eval": "node features/ai/eval/batch.mjs",
    "ai:smoke": "node features/ai/eval/run.mjs --browser edge --cases transfer-amount-en-1,match-part-zh,multi-spend-all-en",
    "ai:report": "node features/ai/eval/report.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@wxt-dev/module-react": "^1.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "everything-webgpu": "https://github.com/nyaaorick/everything-webgpu/releases/download/v0.1.4/everything-webgpu-0.1.4.tgz",
    "lucide-react": "^0.577.0",
    "openai": "6.49.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "wxt": "^0.20.27",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "puppeteer-core": "24.43.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
